{
  "name": "asset-library-desktop",
  "version": "1.0.0",
  "private": true,
  "author": "Sayo Sense",
  "copyright": "Copyright © 2026 Sayo Sense",
  "description": "Sayo Sense Windows 数据管理总控制台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "element-plus": "2.9.3",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "concurrently": "9.1.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "5.4.11",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.assetlibrary.desktop",
    "productName": "Sayo Sense",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Sayo-Sense-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
