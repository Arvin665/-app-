# 复制到项目根目录并命名为 .env
# 所有 CHANGE_ME 都必须替换；不要把填写后的 .env 提交到 GitHub。

MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_ROOT_PASSWORD
MYSQL_DATABASE=mall_office_asset
MYSQL_USER=asset_user
MYSQL_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD
WEB_BIND=127.0.0.1
WEB_PORT=8080

SENSITIVE_FIELD_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
BOOTSTRAP_INVITE_CODE=CHANGE_ME_6_DIGITS
PUBLIC_BASE_URL=https://app.example.com
FILE_URL_TTL_SECONDS=3600
CORS_ORIGINS=https://app.example.com,https://localhost,capacitor://localhost

AI_PROVIDER=auto
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_REAL_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90

OCR_ENABLED=true
OCR_MAX_PDF_PAGES=30
OCR_MIN_TEXT_CHARS=20
ASR_ENGINE=sensevoice
ASR_TIMEOUT_SECONDS=180
FFMPEG_BINARY=/usr/bin/ffmpeg
UPLOAD_DIR=/app/uploads
AUTO_CREATE_TABLES=false
