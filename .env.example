# 复制为 .env 后按实际环境修改。生产环境必须更换所有示例密钥。
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=mall_office_asset
MYSQL_USER=asset_user
MYSQL_PASSWORD=change_me_db
WEB_BIND=127.0.0.1
WEB_PORT=8080
DATABASE_URL=mysql+pymysql://asset_user:change_me_db@mysql:3306/mall_office_asset?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
SENSITIVE_FIELD_KEY=change_me_to_a_long_random_secret_at_least_32_chars
BOOTSTRAP_INVITE_CODE=246810
PUBLIC_BASE_URL=http://localhost
FILE_URL_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,https://localhost,capacitor://localhost
# auto: 配置 DEEPSEEK_API_KEY 后优先使用 DeepSeek，否则使用本地规则。
AI_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90
OCR_ENABLED=true
OCR_MAX_PDF_PAGES=30
OCR_MIN_TEXT_CHARS=20
ASR_TIMEOUT_SECONDS=180
FFMPEG_BINARY=
# auto 优先 SenseVoiceSmall，再降级到 Windows Speech/Vosk。
ASR_ENGINE=auto
# 留空则使用镜像内的 sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2025-09-09
SENSE_VOICE_MODEL_PATH=
VOSK_MODEL_PATH=UPLOAD_DIR=/app/uploads
AUTO_CREATE_TABLES=false
