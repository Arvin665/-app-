{
  "name": "asset-library-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "商办信息资产库 uni-app 移动端",
  "scripts": {
    "dev:h5": "uni -p h5 --host 127.0.0.1 --port 5173",
    "build:h5": "uni build -p h5",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "native:sync": "npm run build:h5 && cap sync",
    "native:sync:android:debug": "npm run build:h5 && node scripts/cap-sync-android-debug.mjs",
    "native:sync:android:release": "npm run build:h5 && node scripts/cap-sync-android-release.mjs",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios",
    "native:build:android:debug": "npm run native:sync:android:debug && cd android && gradlew.bat assembleDebug",
    "native:build:android:release": "node scripts/build-android.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@dcloudio/uni-app": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030620261112001",
    "@lucide/vue": "^1.72.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030620261112001",
    "vite": "5.2.8"
  }
}
